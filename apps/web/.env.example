VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Descope project ID from the console (Project Settings). Same value in both vars.
# Leave blank to run the canvas without sign-in. A management key is not used.
VITE_DESCOPE_PROJECT_ID=
DESCOPE_PROJECT_ID=

# Flow used for sign-up and sign-in. Descope's built-in flow ID is sign-up-or-in.
VITE_DESCOPE_FLOW_ID=sign-up-or-in

# Optional custom Descope API domain. Defaults to https://api.descope.com.
# DESCOPE_BASE_URL=https://api.descope.com
# VITE_DESCOPE_BASE_URL=https://api.descope.com
