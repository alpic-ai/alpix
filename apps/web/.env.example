VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Descope project ID from Project Settings. Public — not a secret.
# Required at build time (baked into the browser bundle) and at runtime
# (Netlify function GET /api/session). A management key is not used.
DESCOPE_PROJECT_ID=
# Optional alias if you prefer the Vite prefix. Ignored when DESCOPE_PROJECT_ID is set.
# VITE_DESCOPE_PROJECT_ID=

# Optional custom Descope API base URL (CNAME). Leave unset for https://api.descope.com.
# DESCOPE_BASE_URL=
# VITE_DESCOPE_BASE_URL=

# Optional hosted flow. Defaults to sign-up-or-in.
# VITE_DESCOPE_FLOW_ID=sign-up-or-in

# Optional session JWT audience. Defaults to DESCOPE_PROJECT_ID.
# DESCOPE_SESSION_AUDIENCE=
