{
  "name": "@alpix/web",
  "version": "0.0.1",
  "private": true,
  "description": "AlpiX WebMCP challenge site",
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter @alpix/auth build",
    "dev": "vite",
    "build": "pnpm --filter @alpix/auth build && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit && vite build",
    "preview": "vite preview",
    "test": "tsx --test src/auth/access.test.ts"
  },
  "dependencies": {
    "@alpic-ai/ui": "^1.161.0",
    "@alpix/auth": "workspace:*",
    "@alpix/component": "workspace:*",
    "@descope/react-sdk": "^3.3.14",
    "@supabase/supabase-js": "^2.112.0",
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0",
    "tw-animate-css": "^1.4.0",
    "webmcp-react": "^0.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.5",
    "typescript": "^7.0.2",
    "vite": "^8.2.0"
  },
  "engines": {
    "node": ">=24.14.1"
  },
  "packageManager": "pnpm@10.34.5"
