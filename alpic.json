{
  "$schema": "https://assets.alpic.ai/alpic.json",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @alpix/mcp... build && cp apps/mcp/.vercel/output/functions/*.func/index.js apps/mcp/dist/bundle.js",
  "buildOutputDir": "apps/mcp/dist",
  "startCommand": "cd apps/mcp && NODE_ENV=production __PORT=${PORT:-3000} node dist/bundle.js"
}
